{
  "name": "gitlab-github-contributions-sync",
  "version": "1.0.0",
  "description": "Sync GitLab commit activity to a GitHub repository (metadata only)",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run tsc",
    "start": "bun dist/index.js",
    "sync": "bun run build && bun run start",
    "dev": "bun src/index.ts",
    "typecheck": "bun run tsc --noEmit",
    "format": "bun run biome format --write",
    "lint": "bun run biome lint --write",
    "check": "bun run biome check --write"
  },
  "keywords": [
    "gitlab",
    "github",
    "contributions",
    "sync"
  ],
  "author": "Kévin Véronési",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
